{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "requestId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "appId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "appRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "policyId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "policyVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "contextId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "measurementProfileId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "kind": {
      "type": "string",
      "enum": ["subject", "product"]
    },
    "generatedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expiresAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "seed": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "candidates": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subjectId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "ruleRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "entityRef": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          }
        },
        "required": ["subjectId", "ruleRevision"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "requestId",
    "appId",
    "appRevision",
    "policyId",
    "policyVersion",
    "contextId",
    "measurementProfileId",
    "kind",
    "generatedAt",
    "expiresAt",
    "seed",
    "candidates"
  ],
  "additionalProperties": false
}
