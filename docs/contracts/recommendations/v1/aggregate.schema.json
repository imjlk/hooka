{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "producerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "appId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "measurementProfileId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "periodStart": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "periodEnd": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "generatedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rows": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assignmentId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "exposures": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "clicks": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "dispatches": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": ["assignmentId", "exposures", "clicks", "dispatches"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "producerId",
    "appId",
    "measurementProfileId",
    "periodStart",
    "periodEnd",
    "revision",
    "generatedAt",
    "rows"
  ],
  "additionalProperties": false
}
