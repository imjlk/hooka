{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "manifestId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "producerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "appId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "appRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "generatedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "assignments": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "assignmentId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "decisionId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "subjectId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "ruleRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "mappingVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "entityRef": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "contextId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "measurementProfileId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "startsAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "endsAt": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "experiment": {
            "type": "string",
            "enum": ["training", "holdout"]
          },
          "application": {
            "type": "string",
            "enum": ["sampler", "constrained", "fallback"]
          },
          "appliedProbability": {
            "anyOf": [
              {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "assignmentId",
          "decisionId",
          "subjectId",
          "ruleRevision",
          "mappingVersion",
          "contextId",
          "measurementProfileId",
          "startsAt",
          "endsAt",
          "experiment",
          "application",
          "appliedProbability"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "manifestId",
    "producerId",
    "appId",
    "appRevision",
    "generatedAt",
    "assignments"
  ],
  "additionalProperties": false
}
