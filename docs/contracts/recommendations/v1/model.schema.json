{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "modelGenerationId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "generatedAt": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rows": {
      "maxItems": 100000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "appId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "subjectId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "ruleRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "mappingVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "entityRef": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "contextId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "measurementProfileId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "day": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "experiment": {
            "type": "string",
            "enum": ["training", "holdout"]
          },
          "exposures": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "clicks": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "dispatches": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "appId",
          "subjectId",
          "ruleRevision",
          "mappingVersion",
          "contextId",
          "measurementProfileId",
          "day",
          "experiment",
          "exposures",
          "clicks",
          "dispatches"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "modelGenerationId", "generatedAt", "rows"],
  "additionalProperties": false
}
