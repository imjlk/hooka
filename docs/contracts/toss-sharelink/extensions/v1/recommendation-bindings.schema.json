{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "apps": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "appId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "sharelinkRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "recommendationRevision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "policyId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "policyVersion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "contextId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "measurementProfileId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "catalogScope": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "subjects": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "subjectId": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
                },
                "sharelinkRuleRevision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "recommendationRuleRevision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "subjectId",
                "sharelinkRuleRevision",
                "recommendationRuleRevision"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "appId",
          "sharelinkRevision",
          "recommendationRevision",
          "policyId",
          "policyVersion",
          "contextId",
          "measurementProfileId",
          "catalogScope",
          "subjects"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "apps"],
  "additionalProperties": false
}
