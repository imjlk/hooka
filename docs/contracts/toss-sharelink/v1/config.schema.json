{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "accounts": {
      "minItems": 1,
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "publisherId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "accessKeyEnv": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
          },
          "secretKeyEnv": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
          },
          "productBudget": {
            "default": 9000,
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "linkBudget": {
            "default": 9000,
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        },
        "required": [
          "accountId",
          "publisherId",
          "accessKeyEnv",
          "secretKeyEnv"
        ],
        "additionalProperties": false
      }
    },
    "apps": {
      "minItems": 1,
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "appId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "accountId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
          },
          "revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "subTagId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]{1,64}$"
          },
          "subjects": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "subjectId": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
                },
                "revision": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "enabled": {
                  "default": true,
                  "type": "boolean"
                },
                "categoryId": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,15}$"
                },
                "catalogSource": {
                  "default": "category-best",
                  "type": "string",
                  "enum": ["category-best", "today-deals", "overall-best"]
                },
                "keywords": {
                  "minItems": 1,
                  "maxItems": 8,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 40,
                    "pattern": "^[^\\p{Cc}]*$"
                  }
                },
                "excludedKeywords": {
                  "default": [],
                  "maxItems": 8,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 40,
                    "pattern": "^[^\\p{Cc}]*$"
                  }
                },
                "excludedCategoryIds": {
                  "default": [],
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,15}$"
                  }
                },
                "excludedProductIds": {
                  "default": [],
                  "maxItems": 100,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,15}$"
                  }
                },
                "manual": {
                  "type": "object",
                  "properties": {
                    "productId": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]{0,15}$"
                    },
                    "title": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 180,
                      "pattern": "^[^\\p{Cc}]*$"
                    },
                    "url": {
                      "type": "string"
                    },
                    "reviewedAt": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "reviewUntil": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "productId",
                    "title",
                    "url",
                    "reviewedAt",
                    "reviewUntil"
                  ],
                  "additionalProperties": false
                }
              },
              "required": ["subjectId", "revision", "categoryId", "keywords"],
              "additionalProperties": false
            }
          }
        },
        "required": ["appId", "accountId", "revision", "subTagId", "subjects"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "accounts", "apps"],
  "additionalProperties": false
}
