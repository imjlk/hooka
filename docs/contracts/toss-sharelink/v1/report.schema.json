                "maximum": 9007199254740991
              },
              "productAmount": {
                "type": "number"
              },
              "promotionCost": {
                "type": "number"
              },
              "settlementBase": {
                "type": "number"
              },
              "commissionAmount": {
                "type": "number"
              },
              "latestConfirmedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 64
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "productId": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "productName": {
                "type": "string",
                "maxLength": 1000
              },
              "attribution": {
                "type": "string",
                "enum": ["DIRECT", "INDIRECT", "UNKNOWN"]
              }
            },
            "required": [
              "orderProductCount",
              "productAmount",
              "promotionCost",
              "settlementBase",
              "commissionAmount",
              "latestConfirmedAt",
              "productId",
              "productName",
              "attribution"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "kind",
        "appId",
        "collectedAt",
        "settlementMonth",
        "attribution",
        "summary",
        "items"
      ],
      "additionalProperties": false
    }
  ]
}
