{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "appId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "settlementMonth": {
      "type": "string",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])$"
    },
    "attribution": {
      "type": "string",
      "enum": ["DIRECT", "INDIRECT", "UNKNOWN"]
    }
  },
  "required": ["schemaVersion", "appId", "settlementMonth"],
  "additionalProperties": false
}
