# Copy to .env in EACH stack directory; never commit the filled file.
HOOKA_VERSION=1.4.0
SHARELINK_CONFIG_DIR=./sharelink-config
# Use these SAME names on the SAME Docker host for both stacks.
SHARELINK_PRIVATE_VOLUME=hooka-sharelink-private
SHARELINK_RESULTS_VOLUME=hooka-sharelink-results
# Generate distinct random secrets for each stack; these are not Toss keys.
HOOKA_SHOPPING_WEBHOOK_SECRET=
HOOKA_SHOPPING_ADMIN_TOKEN=
# Store approved provider credentials in Coolify secrets or the protected .env.
# Use the same provider account in both configs/stacks to share budgets/cache.
TOSS_SHARELINK_ACCESS_KEY=
TOSS_SHARELINK_SECRET_KEY=
